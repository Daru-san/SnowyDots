bar {
	enabled #false
	anchor "top" "left" "right"
	monitors "HDMI-A-2"
	height 30
	orientation "horizontal"
	spacing 12
	modules {
		start {

		}
		center {
			popup "island-group"
		}
		end {
			popup "system-group"
			popup "audio"
			popup "networking"
		}
	}
	configs {
		popup "island-group" {
			child { group "island" }
		}
		group "island" {
			orientation "horizontal"
			modules {
				music-mini
				clock
				notification-icon
				tray
			}
		}
		popup "system-group" {
			child { group "system-mini" }
			popup-child { group "system-full" }
			show-arrow
		}
		group "system-mini" {
			orientation "horizontal"
			modules {
				cpu-mini "overview"
				memory-mini "overview"
				netstats-mini
			}
		}
		group "system-full" {
			orientation "vertical"
			modules {
				cpu-applet
				memory-applet
				netstats-applet
			}
		}
		popup "networking" {
			child { group "networking-mini" }
		}
		group "networking-mini" {
			orientation "horizontal"
			modules {
				network-mini
				bluetooth-mini
			}
		}
	}
}
